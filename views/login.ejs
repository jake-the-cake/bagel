<% layout("base") %>

<main class="container container--sm py-md">
  <section class="panel stack-lg">
    <header>
      <p class="eyebrow">Account Access</p>
      <h1>Log in</h1>
      <p class="text-muted">Enter your account information to continue.</p>
    </header>

    <form id="login-form" class="form">
      <div class="form-field">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
        />
      </div>

      <div class="form-field">
        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>

      <p id="login-error" class="form-error" hidden></p>

      <button type="submit" class="button button--primary">Log in</button>
    </form>
  </section>
</main>

<script>
  const form = document.getElementById("login-form");
  const error = document.getElementById("login-error");

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    error.hidden = true;

    const sessionId = localStorage.getItem("JSYS_SESSION_ID");
    const userToken = localStorage.getItem("JSYS_USER_TOKEN");

    const headers = {
      "Content-Type": "application/json",
    };

    if (sessionId) {
      headers["X-Session-ID"] = sessionId;
    }

    if (userToken) {
      headers.Authorization = `Bearer ${userToken}`;
    }

    try {
      const response = await fetch("/api/auth/login", {
        method: "POST",
        headers,
        body: JSON.stringify({
          email: form.email.value.trim(),
          password: form.password.value,
        }),
      });

      const body = await response.json();

      if (!response.ok) {
        throw new Error(body?.message ?? "Unable to log in.");
      }

      const newSessionId = response.headers.get("x-session-id");
      const newToken = response.headers.get("token");

      if (newSessionId) {
        localStorage.setItem("JSYS_SESSION_ID", newSessionId);
      }

      if (newToken) {
        localStorage.setItem("JSYS_USER_TOKEN", newToken);
      }

      window.location.href = "/app";
    } catch (err) {
      error.textContent = err.message;
      error.hidden = false;
    }
  });
</script>
