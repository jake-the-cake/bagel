<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= error.status %> - <%= error.label %></title>
    <link rel="stylesheet" href="/static/css/style.css" />
  </head>
  <body>
    <div class="error-container">
      <h1><%= error.status %></h1>
      <p><i><%= error.label %></i></p>
      <hr />
      <p><%= error.message %></p>
    </div>
  </body>
</html>
