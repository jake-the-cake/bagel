<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Application</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        display: grid;
        place-items: center;
        height: 100vh;
        width: 100vw;
      }
      h1 {
        padding: 0;
        margin: 0;
      }
      .box {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 2rem;
        align-items: center;
        border: 3px solid darkblue;
        background-color: lightblue;
        color: darkblue;
      }
    </style>
  </head>
  <body>
    <div class="box">
      <h1>Welcome</h1>
      <input type="text" name="field" id="field" />
    </div>
  </body>
</html>
